# PostgreSQL image and version used by Docker Compose.
POSTGRES_IMAGE=pgvector/pgvector:pg16

# PostgreSQL application user.
POSTGRES_USER=change-me

# PostgreSQL application password.
POSTGRES_PASSWORD=change-me

# PostgreSQL database name.
POSTGRES_DB=change-me

# Restart policy applied to both backend services.
RESTART_POLICY=unless-stopped

# Interval between PostgreSQL health checks.
POSTGRES_HEALTHCHECK_INTERVAL=5s

# Timeout for each PostgreSQL health check.
POSTGRES_HEALTHCHECK_TIMEOUT=5s

# Failed PostgreSQL health checks allowed before marking it unhealthy.
POSTGRES_HEALTHCHECK_RETRIES=10

# Async database URL using the Docker database hostname.
DATABASE_URL=postgresql+asyncpg://change-me:change-me@db:5432/change-me

# Comma-separated frontend origins allowed by the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Published and container port for the API.
API_PORT=8000

# Network interface used by the API server.
API_HOST=0.0.0.0

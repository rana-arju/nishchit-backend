# PostgreSQL image and version used by Docker Compose.
POSTGRES_IMAGE=pgvector/pgvector:pg16

# PostgreSQL application user.
POSTGRES_USER=change-me

# PostgreSQL application password.
POSTGRES_PASSWORD=change-me

# PostgreSQL database name.
POSTGRES_DB=change-me

# Restart policy applied to both backend services.
RESTART_POLICY=unless-stopped

# Interval between PostgreSQL health checks.
POSTGRES_HEALTHCHECK_INTERVAL=5s

# Timeout for each PostgreSQL health check.
POSTGRES_HEALTHCHECK_TIMEOUT=5s

# Failed PostgreSQL health checks allowed before marking it unhealthy.
POSTGRES_HEALTHCHECK_RETRIES=10

# Async database URL using the Docker database hostname.
DATABASE_URL=postgresql+asyncpg://change-me:change-me@db:5432/change-me

# Comma-separated frontend origins allowed by the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Published and container port for the API.
API_PORT=8000

# Network interface used by the API server.
API_HOST=0.0.0.0

# Secret used to sign access/refresh JWTs. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

# Algorithm used to sign JWTs.
JWT_ALGORITHM=HS256

# How long an access token stays valid.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# How long a refresh token stays valid.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Whether auth cookies require HTTPS (or a secure-context browser exception like localhost).
COOKIE_SECURE=true

# "none" is required when the frontend and backend are on different origins (e.g. local dev).
# Use "lax" once both are served from the same domain in production.
COOKIE_SAMESITE=none

# Where to redirect the browser after a successful/failed OAuth login.
FRONTEND_URL=http://localhost:3000

# Google OAuth app credentials (console.cloud.google.com -> APIs & Services -> Credentials).
# Leave empty to disable Google login (it returns a clear "not configured" error).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Facebook OAuth app credentials (developers.facebook.com -> your app -> Settings -> Basic).
# Leave empty to disable Facebook login (it returns a clear "not configured" error).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/facebook/callback

# How long a password-reset OTP code stays valid.
OTP_EXPIRE_MINUTES=10

# How many wrong OTP attempts are allowed before it's locked (must request a new one).
OTP_MAX_ATTEMPTS=5

# Minimum seconds between two OTP requests for the same account.
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP server used to email OTP codes. Leave SMTP_HOST empty for local dev — the OTP is
# logged to the backend console instead (see `docker compose logs api`).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@nishchit.local
SMTP_USE_TLS=true
